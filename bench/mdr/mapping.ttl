@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <http://example.org/> .

# tests/diff/0001-mdr/mapping.ttl with ObservableMap and the customer maps
# added.

<#AssetMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "assets" ] ;
  rr:subjectMap [ rr:template "http://example.org/asset/{id}" ; rr:class ex:Asset ] ;
  rr:predicateObjectMap [ rr:predicate ex:hostname ; rr:objectMap [ rr:column "hostname" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:criticality ; rr:objectMap [ rr:column "criticality" ] ] .

<#FindingMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "alerts" ] ;
  rr:subjectMap [ rr:template "http://example.org/alert/{id}" ; rr:class ex:DetectionFinding ] ;
  rr:predicateObjectMap [ rr:predicate ex:title ; rr:objectMap [ rr:column "title" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:severityId ; rr:objectMap [ rr:column "severity_id" ] ] ;
  rr:predicateObjectMap [
    rr:predicate ex:onAsset ;
    rr:objectMap [ rr:template "http://example.org/asset/{asset_id}" ]
  ] .

<#LinkMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "links" ] ;
  rr:subjectMap [ rr:template "http://example.org/asset/{src_id}" ] ;
  rr:predicateObjectMap [
    rr:predicate ex:connectsTo ;
    rr:objectMap [
      rr:parentTriplesMap <#AssetMap> ;
      rr:joinCondition [ rr:child "dst_id" ; rr:parent "id" ]
    ]
  ] .

# No key: a finding can record the same observable twice, which is one
# triple in the RDF graph.
<#ObservableMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "observables" ] ;
  rr:subjectMap [ rr:template "http://example.org/alert/{alert_id}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:observable ; rr:objectMap [ rr:column "value" ] ] .

# Two triples maps with the same predicates and the same subject template:
# a customer in both tables is one subject, and a triple both give counts
# once.
<#CrmCustomerMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "crm_customers" ] ;
  rr:subjectMap [ rr:template "http://example.org/customer/{id}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rr:column "name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:email ; rr:objectMap [ rr:column "email" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:country ; rr:objectMap [ rr:column "country" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:segment ; rr:objectMap [ rr:column "segment" ] ] .

<#BillingCustomerMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "billing_customers" ] ;
  rr:subjectMap [ rr:template "http://example.org/customer/{id}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rr:column "name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:email ; rr:objectMap [ rr:column "email" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:country ; rr:objectMap [ rr:column "country" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:segment ; rr:objectMap [ rr:column "segment" ] ] .
