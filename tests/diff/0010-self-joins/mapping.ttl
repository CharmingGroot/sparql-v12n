@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <http://example.org/> .

<#AssetMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "assets" ] ;
  rr:subjectMap [ rr:template "http://example.org/asset/{id}" ; rr:class ex:Asset ] ;
  rr:predicateObjectMap [ rr:predicate ex:hostname ; rr:objectMap [ rr:column "hostname" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:criticality ; rr:objectMap [ rr:column "criticality" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:site ; rr:objectMap [ rr:column "site" ] ] .

# A second triples map over the same table: its class pattern is another
# scan of assets.
<#DeviceMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "assets" ] ;
  rr:subjectMap [ rr:template "http://example.org/asset/{id}" ; rr:class ex:Device ] .

<#AlertMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "alerts" ] ;
  rr:subjectMap [ rr:template "http://example.org/alert/{id}" ; rr:class ex:Alert ] ;
  rr:predicateObjectMap [ rr:predicate ex:title ; rr:objectMap [ rr:column "title" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:severityId ; rr:objectMap [ rr:column "severity_id" ] ] ;
  rr:predicateObjectMap [
    rr:predicate ex:onAsset ;
    rr:objectMap [ rr:template "http://example.org/asset/{asset_id}" ]
  ] .

<#LinkMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "links" ] ;
  rr:subjectMap [ rr:template "http://example.org/link/{src_id}/{dst_id}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:note ; rr:objectMap [ rr:column "note" ] ] ;
  rr:predicateObjectMap [
    rr:predicate ex:to ;
    rr:objectMap [ rr:template "http://example.org/asset/{dst_id}" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ex:from ;
    rr:objectMap [
      rr:parentTriplesMap <#AssetMap> ;
      rr:joinCondition [ rr:child "src_id" ; rr:parent "id" ]
    ]
  ] .

# The source of a link is not a key of links.
<#SourceMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "links" ] ;
  rr:subjectMap [ rr:template "http://example.org/source/{src_id}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:linkNote ; rr:objectMap [ rr:column "note" ] ] .

<#BadgeMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "badges" ] ;
  rr:subjectMap [ rr:template "http://example.org/badge/{code}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:label ; rr:objectMap [ rr:column "label" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:holder ; rr:objectMap [ rr:column "holder" ] ] .

<#TeamMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "teams" ] ;
  rr:subjectMap [ rr:template "http://example.org/team/{grp}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:x ; rr:objectMap [ rr:column "x" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:y ; rr:objectMap [ rr:column "y" ] ] .

<#PersonMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "people" ] ;
  rr:subjectMap [ rr:template "http://example.org/person/{email}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rr:column "name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:team ; rr:objectMap [ rr:column "team" ] ] .
