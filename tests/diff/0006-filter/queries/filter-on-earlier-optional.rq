PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# ?q comes from an earlier OPTIONAL and may be unbound when the tag's part
# is matched: then the filter is an error and the tag does not match.
SELECT ?i ?q ?t WHERE { ?i ex:name ?n OPTIONAL { ?i ex:qty ?q } OPTIONAL { ?i ex:tag ?t FILTER(?q > 5 || ?t = "small") } }
