---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain(UNION, &format!(\"{PREFIXES}SELECT ?c WHERE {{ ?c ex:name \\\"Ann\\\" }}\"))"
---
SELECT ($1 || CASE WHEN t0."id"::text ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]*$' THEN t0."id"::text WHEN t0."id"::text IS NOT NULL THEN (SELECT coalesce(string_agg(CASE WHEN c ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]$' THEN c ELSE regexp_replace(upper(encode(convert_to(c, 'UTF8'), 'hex')), '(..)', '%\1', 'g') END, '' ORDER BY n), '') FROM generate_series(1, char_length(t0."id"::text)) AS n, substr(t0."id"::text, n, 1) AS c) END)::text AS "c"
FROM "customers" t0
WHERE t0."name" = $2 AND t0."id" IS NOT NULL
UNION
SELECT ($3 || CASE WHEN t0."code"::text ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]*$' THEN t0."code"::text WHEN t0."code"::text IS NOT NULL THEN (SELECT coalesce(string_agg(CASE WHEN c ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]$' THEN c ELSE regexp_replace(upper(encode(convert_to(c, 'UTF8'), 'hex')), '(..)', '%\1', 'g') END, '' ORDER BY n), '') FROM generate_series(1, char_length(t0."code"::text)) AS n, substr(t0."code"::text, n, 1) AS c) END)::text AS "c"
FROM "wholesalers" t0
WHERE t0."name" = $4 AND t0."code" IS NOT NULL
UNION
SELECT (t0."iri"::text)::text AS "c"
FROM "partners" t0
WHERE t0."name" = $5 AND t0."iri" IS NOT NULL

-- params
$1 = "http://example.org/customer/"
$2 = "Ann"
$3 = "http://example.org/wholesale/"
$4 = "Ann"
$5 = "Ann"
