---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_shop_with_types(\"SELECT ?o ?a WHERE { ?o ex:amount ?a } ORDER BY DESC(?a) LIMIT 10 OFFSET 20\")"
---
SELECT t0."id" AS "o", t0."amount" AS "a"
FROM "orders" t0
WHERE t0."id" IS NOT NULL AND t0."amount" IS NOT NULL
ORDER BY t0."amount" DESC
LIMIT $1::int8
OFFSET $2::int8

-- params
$1 = "10"
$2 = "20"
