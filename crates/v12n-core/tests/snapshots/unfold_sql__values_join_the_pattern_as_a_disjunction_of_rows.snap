---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?o ?a WHERE { ?o ex:placedBy ?c ; ex:amount ?a \\\n         VALUES (?c ?a) { (<http://example.org/customer/7> UNDEF) \\\n         (<http://example.org/customer/8> 30000) (<http://example.org/order/1> 5) } }\")"
---
SELECT q."o", q."a"
FROM (
SELECT DISTINCT t0."id" AS "o", t0."customer_id" AS "c", t1."amount" AS "a"
FROM "orders" t0
JOIN "orders" t1 ON t1."id" = t0."id" AND (t0."customer_id" = $1 OR (t0."customer_id" = $2 AND t1."amount" = $3))
WHERE t0."customer_id" IS NOT NULL AND t1."amount" IS NOT NULL
) q

-- params
$1 = "7"
$2 = "8"
$3 = "30000"
