---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?c WHERE { ?c ex:name ?n MINUS { ?c ex:tier ?t FILTER(?t = ?n) } }\")"
---
SELECT q."c"
FROM (
SELECT DISTINCT t0."id" AS "c", t0."name" AS "n"
FROM "customers" t0
LEFT JOIN "customers" t1 ON NULL::bool AND t1."id" = t0."id" AND t1."tier" IS NOT NULL
WHERE t1."id" IS NULL AND t0."id" IS NOT NULL AND t0."name" IS NOT NULL
) q

-- params
