---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain(MULTI,\n&format!(\"{PREFIXES}SELECT ?o WHERE {{ ?o ex:homepage ?c . ?c ex:name ?name }}\"))"
---
SELECT q."o"
FROM (
SELECT t0."id" AS "o", pg_typeof(t0."url")::text || ' ' || t0."url"::text AS "c", pg_typeof(t1."name")::text || ' ' || t1."name"::text AS "name"
FROM "orders" t0
JOIN "retail_customers" t1 ON $1 || CASE WHEN t1."id"::text IS NULL THEN NULL ELSE (SELECT coalesce(string_agg(CASE WHEN c ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]$' THEN c ELSE regexp_replace(upper(encode(convert_to(c, 'UTF8'), 'hex')), '(..)', '%\1', 'g') END, '' ORDER BY n), '') FROM generate_series(1, char_length(t1."id"::text)) AS n, substr(t1."id"::text, n, 1) AS c) END = t0."url"
WHERE t0."id" IS NOT NULL AND t1."name" IS NOT NULL
UNION
SELECT t0."id" AS "o", pg_typeof(t0."url")::text || ' ' || t0."url"::text AS "c", pg_typeof(t1."title")::text || ' ' || t1."title"::text AS "name"
FROM "orders" t0
JOIN (SELECT code, title FROM shop.wholesale) t1 ON $2 || CASE WHEN t1."code"::text IS NULL THEN NULL ELSE (SELECT coalesce(string_agg(CASE WHEN c ~ '^[-.0-9A-Z_a-z~\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF\U00010000-\U0001FFFD\U00020000-\U0002FFFD\U00030000-\U0003FFFD\U00040000-\U0004FFFD\U00050000-\U0005FFFD\U00060000-\U0006FFFD\U00070000-\U0007FFFD\U00080000-\U0008FFFD\U00090000-\U0009FFFD\U000A0000-\U000AFFFD\U000B0000-\U000BFFFD\U000C0000-\U000CFFFD\U000D0000-\U000DFFFD\U000E1000-\U000EFFFD]$' THEN c ELSE regexp_replace(upper(encode(convert_to(c, 'UTF8'), 'hex')), '(..)', '%\1', 'g') END, '' ORDER BY n), '') FROM generate_series(1, char_length(t1."code"::text)) AS n, substr(t1."code"::text, n, 1) AS c) END = t0."url"
WHERE t0."id" IS NOT NULL AND t1."title" IS NOT NULL
) q

-- params
$1 = "http://example.org/customer/"
$2 = "http://example.org/customer/"
