---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain(MULTI,\n&format!(\"{PREFIXES}ASK {{ ?c a ex:Customer ; ex:name ?name }}\"))"
---
SELECT 1
FROM "retail_customers" t0
WHERE t0."id" IS NOT NULL AND t0."name" IS NOT NULL
UNION ALL
SELECT 1
FROM "retail_customers" t0
JOIN (SELECT code, title FROM shop.wholesale) t1 ON t1."code" = t0."id"
WHERE t1."title" IS NOT NULL
UNION ALL
SELECT 1
FROM (SELECT code, title FROM shop.wholesale) t0
JOIN "retail_customers" t1 ON t1."id" = t0."code"
WHERE t1."name" IS NOT NULL
UNION ALL
SELECT 1
FROM (SELECT code, title FROM shop.wholesale) t0
WHERE t0."code" IS NOT NULL AND t0."title" IS NOT NULL
LIMIT $1::int8

-- params
$1 = "1"
