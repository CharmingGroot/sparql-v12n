---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_merged(\"SELECT ?f ?t WHERE { ?f ex:severityId ?s ; ex:title ?t FILTER(?s >= 3) } \\\n         ORDER BY DESC(?s) ?t LIMIT 10\")"
---
SELECT t0."id" AS "f", t0."title" AS "t", (t0."severity_id"::text) COLLATE "C" AS "o1_text", (t0."title"::text) COLLATE "C" AS "o2_text"
FROM "alerts" t0
WHERE t0."severity_id" >= $1::int8 AND t0."severity_id" IS NOT NULL AND t0."title" IS NOT NULL
ORDER BY "o1_text" DESC, "o2_text"
LIMIT $2::int8

-- params
$1 = "3"
$2 = "10"
