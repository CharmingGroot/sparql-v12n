---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?c ?o WHERE { ?c ex:tier ?t \\\n         OPTIONAL { ?o ex:placedBy ?c FILTER(!EXISTS { ?o ex:amount 10 }) } \\\n         FILTER(?t = \\\"VIP\\\" || EXISTS { ?x ex:placedBy ?c }) }\")"
---
SELECT q."c", q."o"
FROM (
SELECT DISTINCT t0."id" AS "c", t0."tier" AS "t", t1."id" AS "o"
FROM "customers" t0
LEFT JOIN "orders" t1 ON t1."customer_id" = t0."id" AND NOT (EXISTS (SELECT 1 FROM "orders" t2 WHERE t2."amount" = $1 AND t2."id" = t1."id")) AND t1."id" IS NOT NULL
WHERE ((t0."tier" = $2) OR EXISTS (SELECT 1 FROM "orders" t3 WHERE t3."customer_id" = t0."id" AND t3."id" IS NOT NULL)) AND t0."id" IS NOT NULL AND t0."tier" IS NOT NULL
) q

-- params
$1 = "10"
$2 = "VIP"
