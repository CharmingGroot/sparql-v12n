---
source: crates/v12n-core/tests/unfold_sql.rs
assertion_line: 821
expression: "shop(\"SELECT ?c (?a + 1 AS ?n) WHERE { ?o ex:amount ?a ; ex:placedBy ?c }\")"
---
SELECT q."c", q."n", q."n_1", q."n_2"
FROM (
SELECT DISTINCT t0."id" AS "o", t0."amount" AS "a", t1."customer_id" AS "c", (t0."amount"::numeric + $1::numeric) AS "n", NULL::numeric AS "n_1", NULL::float8 AS "n_2", (NULL::float8)::text AS "n_2_key"
FROM "orders" t0
JOIN "orders" t1 ON t1."id" = t0."id"
WHERE t0."amount" IS NOT NULL AND t1."customer_id" IS NOT NULL
) q

-- params
$1 = "1"
