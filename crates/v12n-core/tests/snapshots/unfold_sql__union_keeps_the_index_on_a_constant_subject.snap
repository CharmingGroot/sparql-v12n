---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_with_union_types(\"SELECT ?v WHERE { <http://example.org/item/1> ex:value ?v }\")"
---
SELECT t0."value" AS "v", NULL::"pg_catalog"."text" AS "v_1"
FROM "readings" t0
WHERE t0."id" = $1 AND t0."value" IS NOT NULL
UNION
SELECT NULL::"pg_catalog"."int4" AS "v", t0."value" AS "v_1"
FROM "labels" t0
WHERE t0."id" = $2 AND t0."value" IS NOT NULL
