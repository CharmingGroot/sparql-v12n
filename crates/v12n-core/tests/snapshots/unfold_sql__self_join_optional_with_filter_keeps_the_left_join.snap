---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_merged(\"SELECT ?a ?c WHERE { ?a a ex:Asset \\\n         OPTIONAL { ?a ex:criticality ?c FILTER(?c != \\\"Low\\\") } }\")"
---
SELECT t0."id" AS "a", t1."criticality" AS "c"
FROM "assets" t0
LEFT JOIN "assets" t1 ON t1."id" = t0."id" AND NOT (coalesce((t1."criticality" = $1), false)) AND t1."criticality" IS NOT NULL
WHERE t0."id" IS NOT NULL

-- params
$1 = "Low"
