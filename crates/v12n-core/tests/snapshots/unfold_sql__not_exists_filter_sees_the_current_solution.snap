---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?c WHERE { ?c ex:name ?n FILTER NOT EXISTS { ?d ex:tier ?t FILTER(?t = ?n) } }\")"
---
SELECT q."c"
FROM (
SELECT DISTINCT t0."id" AS "c", t0."name" AS "n"
FROM "customers" t0
WHERE NOT (EXISTS (SELECT 1 FROM "customers" t1 WHERE (t1."tier" = t0."name") AND t1."id" IS NOT NULL AND t1."tier" IS NOT NULL)) AND t0."id" IS NOT NULL AND t0."name" IS NOT NULL
) q

-- params
