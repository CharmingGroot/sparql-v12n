---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_merged(\"SELECT ?asset WHERE { ?asset a ex:Asset . MINUS { ?asset ex:criticality ?c } }\")"
---
SELECT t0."id" AS "asset"
FROM "assets" t0
WHERE CASE WHEN t0."criticality" IS NOT NULL THEN t0."id" END IS NULL AND t0."id" IS NOT NULL

