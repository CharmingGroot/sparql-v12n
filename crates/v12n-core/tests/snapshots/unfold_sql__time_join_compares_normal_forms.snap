---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_with_time_types(\"SELECT ?s ?a WHERE { ?s ex:starts ?t . ?a ex:at ?t }\",\n&[])"
---
SELECT q."s", q."a"
FROM (
SELECT DISTINCT t0."id" AS "s", (t0."starts" + interval '0') AS "t", (t1."at" + interval '0') AS "a"
FROM "shifts" t0
JOIN "alarms" t1 ON (t1."at" + interval '0') = (t0."starts" + interval '0')
WHERE t0."id" IS NOT NULL
) q
