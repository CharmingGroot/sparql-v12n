---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_shop_with_types(\"SELECT ?c ?n WHERE { ?c ex:name ?n } ORDER BY ?n DESC(?c)\")"
---
SELECT t0."id" AS "c", t0."name" AS "n", (t0."name"::text) COLLATE "C" AS "o1_text", ($1 || t0."id"::text) COLLATE "C" AS "o2_text"
FROM "customers" t0
WHERE t0."id" IS NOT NULL AND t0."name" IS NOT NULL
ORDER BY "o1_text", "o2_text" DESC

-- params
$1 = "http://example.org/customer/"
