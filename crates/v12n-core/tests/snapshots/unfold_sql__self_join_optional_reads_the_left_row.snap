---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_merged(\"SELECT ?asset ?criticality WHERE { ?asset a ex:Asset . \\\n         OPTIONAL { ?asset ex:criticality ?criticality } }\")"
---
SELECT t0."id" AS "asset", t0."criticality" AS "criticality"
FROM "assets" t0
WHERE t0."id" IS NOT NULL

