---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?c WHERE { ?c ex:name ?n FILTER EXISTS { ?o ex:placedBy ?c ; ex:amount ?a } }\")"
---
SELECT q."c"
FROM (
SELECT DISTINCT t0."id" AS "c", t0."name" AS "n"
FROM "customers" t0
WHERE EXISTS (SELECT 1 FROM "orders" t1
JOIN "orders" t2 ON t2."id" = t1."id" WHERE t1."customer_id" = t0."id" AND t2."amount" IS NOT NULL) AND t0."id" IS NOT NULL AND t0."name" IS NOT NULL
) q

-- params
