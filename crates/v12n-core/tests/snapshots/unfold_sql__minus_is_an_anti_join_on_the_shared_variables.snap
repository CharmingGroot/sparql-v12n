---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(\"SELECT ?o WHERE { ?o ex:placedBy ?c ; ex:amount ?a MINUS { ?c ex:tier \\\"VIP\\\" } }\")"
---
SELECT q."o"
FROM (
SELECT DISTINCT t0."id" AS "o", t0."customer_id" AS "c", t1."amount" AS "a"
FROM "orders" t0
JOIN "orders" t1 ON t1."id" = t0."id"
LEFT JOIN "customers" t2 ON t2."tier" = $1 AND t2."id" = t0."customer_id"
WHERE t2."id" IS NULL AND t0."customer_id" IS NOT NULL AND t1."amount" IS NOT NULL
) q

-- params
$1 = "VIP"
