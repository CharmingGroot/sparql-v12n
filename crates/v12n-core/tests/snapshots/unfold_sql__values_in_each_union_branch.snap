---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain(MULTI,\n&format!(\"{PREFIXES}SELECT ?c WHERE {{ ?c a ex:Customer ; ex:name ?name }} \\\n             VALUES ?name {{ \\\"Kim\\\" \\\"Lee\\\" }}\"))"
---
SELECT q."c"
FROM (
SELECT t0."id" AS "c", pg_typeof(t0."name")::text || ' ' || t0."name"::text AS "name"
FROM "retail_customers" t0
WHERE (t0."name" = $1 OR t0."name" = $2) AND t0."id" IS NOT NULL AND t0."name" IS NOT NULL
UNION
SELECT t0."id" AS "c", pg_typeof(t1."title")::text || ' ' || t1."title"::text AS "name"
FROM "retail_customers" t0
JOIN (SELECT code, title FROM shop.wholesale) t1 ON t1."code" = t0."id"
WHERE (t1."title" = $3 OR t1."title" = $4) AND t1."title" IS NOT NULL
UNION
SELECT t0."code" AS "c", pg_typeof(t1."name")::text || ' ' || t1."name"::text AS "name"
FROM (SELECT code, title FROM shop.wholesale) t0
JOIN "retail_customers" t1 ON t1."id" = t0."code"
WHERE (t1."name" = $5 OR t1."name" = $6) AND t1."name" IS NOT NULL
UNION
SELECT t0."code" AS "c", pg_typeof(t0."title")::text || ' ' || t0."title"::text AS "name"
FROM (SELECT code, title FROM shop.wholesale) t0
WHERE (t0."title" = $7 OR t0."title" = $8) AND t0."code" IS NOT NULL AND t0."title" IS NOT NULL
) q

-- params
$1 = "Kim"
$2 = "Lee"
$3 = "Kim"
$4 = "Lee"
$5 = "Kim"
$6 = "Lee"
$7 = "Kim"
$8 = "Lee"
