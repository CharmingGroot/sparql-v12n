---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_with_keys(SHOP,\n&format!(\"{PREFIXES}SELECT ?c ?n ?o ?a WHERE {{ ?c ex:name ?n \\\n             OPTIONAL {{ ?o ex:placedBy ?c ; ex:amount ?a }} }}\"),\nSome(&shop_keys()))"
---
SELECT t0."id" AS "c", t0."name" AS "n", t1."id" AS "o", t2."amount" AS "a"
FROM "customers" t0
LEFT JOIN ("orders" t1
JOIN "orders" t2 ON t2."id" = t1."id") ON t1."customer_id" = t0."id" AND t2."amount" IS NOT NULL
WHERE t0."id" IS NOT NULL AND t0."name" IS NOT NULL

-- params
