---
source: crates/v12n-core/tests/unfold_sql.rs
assertion_line: 812
expression: "explain_shop_with_types(\"SELECT ?c (?a + 1 AS ?next) WHERE { ?c ex:tier ?t OPTIONAL { ?o ex:placedBy ?c ; ex:amount ?a } }\")"
---
SELECT t0."id" AS "c", CASE WHEN t2."amount" IS NOT NULL THEN (t2."amount"::numeric + $1::numeric) END AS "next", NULL::numeric AS "next_1", NULL::float8 AS "next_2"
FROM "customers" t0
LEFT JOIN ("orders" t1
JOIN "orders" t2 ON t2."id" = t1."id") ON t1."customer_id" = t0."id" AND t2."amount" IS NOT NULL
WHERE t0."id" IS NOT NULL AND t0."tier" IS NOT NULL

-- params
$1 = "1"
