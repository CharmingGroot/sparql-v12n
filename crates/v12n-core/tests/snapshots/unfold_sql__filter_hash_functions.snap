---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_shop_with_types(\"SELECT ?c WHERE { ?c ex:name ?n ; ex:tier ?t \\\n         FILTER(MD5(?n) = \\\"f55fbaaca148300ac11f7752528cae3d\\\" \\\n         && STRSTARTS(SHA256(?t), \\\"986e\\\") && SHA384(?n) != SHA512(?t)) }\")"
---
SELECT t0."id" AS "c"
FROM "customers" t0
JOIN "customers" t1 ON t1."id" = t0."id" AND ((((md5(convert_to((t0."name"::text), 'UTF8')) COLLATE "C") = $1::text) AND ((encode(sha256(convert_to((t1."tier"::text), 'UTF8')), 'hex') COLLATE "C") COLLATE "C" LIKE $2::text)) AND NOT (((encode(sha384(convert_to((t0."name"::text), 'UTF8')), 'hex') COLLATE "C") = (encode(sha512(convert_to((t1."tier"::text), 'UTF8')), 'hex') COLLATE "C"))))
WHERE t0."name" IS NOT NULL AND t1."tier" IS NOT NULL

-- params
$1 = "f55fbaaca148300ac11f7752528cae3d"
$2 = "986e%"
