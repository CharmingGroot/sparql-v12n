---
source: crates/v12n-core/tests/unfold_sql.rs
assertion_line: 803
expression: "explain_shop_with_types(\"SELECT ?o (?a / 4 AS ?quarter) WHERE { ?o ex:amount ?a }\")"
---
SELECT t0."id" AS "o", (t0."amount"::numeric / NULLIF($1::numeric, 0)) AS "quarter", NULL::float8 AS "quarter_1"
FROM "orders" t0
WHERE t0."id" IS NOT NULL AND t0."amount" IS NOT NULL

-- params
$1 = "4"
