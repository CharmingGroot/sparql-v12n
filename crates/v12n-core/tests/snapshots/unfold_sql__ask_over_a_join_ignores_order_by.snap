---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "shop(r#\"ASK { ?o ex:placedBy ?c . ?c ex:tier \"VIP\" } ORDER BY ?o\"#)"
---
SELECT 1
FROM "orders" t0
JOIN "customers" t1 ON t1."id" = t0."customer_id"
WHERE t1."tier" = $1 AND t0."id" IS NOT NULL
LIMIT $2::int8

-- params
$1 = "VIP"
$2 = "1"
