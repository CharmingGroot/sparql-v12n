---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_with_keys(UNION,\n&format!(\"{PREFIXES}SELECT ?x ?y ?a WHERE {{ {{ ?x ex:city ?y }} UNION {{ ?x ex:amount ?a }} }}\"),\nSome(&union_keys()))"
---
SELECT t0."id" AS "x", NULL AS "x_1", t0."city" AS "y", NULL AS "a"
FROM "customers" t0
WHERE t0."id" IS NOT NULL AND t0."city" IS NOT NULL
UNION ALL
SELECT NULL AS "x", t0."id" AS "x_1", NULL AS "y", t0."amount" AS "a"
FROM "orders" t0
WHERE t0."id" IS NOT NULL AND t0."amount" IS NOT NULL

-- params
