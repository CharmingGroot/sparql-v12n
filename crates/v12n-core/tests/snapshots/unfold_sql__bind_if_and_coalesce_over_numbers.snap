---
source: crates/v12n-core/tests/unfold_sql.rs
expression: "explain_shop_with_types(\"SELECT ?c ?n ?h WHERE { ?c ex:tier ?t OPTIONAL { ?o ex:placedBy ?c ; ex:amount ?a } \\\n         BIND(COALESCE(?a * 1, 0) AS ?n) BIND(IF(?t = \\\"VIP\\\", ?a / 2, 0) AS ?h) }\")"
---
SELECT t0."id" AS "c", CASE WHEN t2."amount" IS NOT NULL AND ((t2."amount"::numeric * $1::numeric) IS NOT NULL) THEN (t2."amount"::numeric * $2::numeric) WHEN true THEN $3::numeric END AS "n", NULL::numeric AS "n_1", NULL::float8 AS "n_2", CASE WHEN (t0."tier" = $4) AND t2."amount" IS NOT NULL THEN NULL::numeric WHEN NOT (coalesce((t0."tier" = $5), false)) THEN $6::numeric END AS "h", CASE WHEN (t0."tier" = $7) AND t2."amount" IS NOT NULL THEN (t2."amount"::numeric / NULLIF($8::numeric, 0)) WHEN NOT (coalesce((t0."tier" = $9), false)) THEN NULL::numeric END AS "h_1", NULL::float8 AS "h_2"
FROM "customers" t0
LEFT JOIN ("orders" t1
JOIN "orders" t2 ON t2."id" = t1."id") ON t1."customer_id" = t0."id" AND t2."amount" IS NOT NULL
WHERE t0."id" IS NOT NULL AND t0."tier" IS NOT NULL

-- params
$1 = "1"
$2 = "1"
$3 = "0"
$4 = "VIP"
$5 = "VIP"
$6 = "0"
$7 = "VIP"
$8 = "2"
$9 = "VIP"
